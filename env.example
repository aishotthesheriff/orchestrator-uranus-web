#Admin & Test Keys
ADMIN_API_KEYS=XXX
TEST_API_KEY=XXX

#Database Configuration
# For local development (outside Docker), use localhost:
DATABASE_URL=postgresql://postgres:password@localhost:5432/uranus_dungeon
# For Docker Compose, use the service name:
# DATABASE_URL=postgresql://postgres:password@postgres:5432/uranus_dungeon

# Session / JWT Configuration
SESSION_SECRET=XXX
# Optional: override JWT signing secret (defaults to SESSION_SECRET)
# JWT_SECRET=XXX

# OpenAI API Configuration
OPENAI_API_KEY=XXX
AI_INTEGRATIONS_OPENAI_API_KEY=XXX
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Hugging Face (for image models)
HF_TOKEN=XXX

# Application Configuration
NODE_ENV=development
PORT=5001

# Security Configuration
ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=false
CSRF_ENABLED=false

CONSOLE_LLM_LOG=true

# Image Cache Configuration
# Set to 'false' to disable similarity-based image caching (only exact hash matches will be used)
IMAGE_SIMILARITY_CACHE_ENABLED=true
