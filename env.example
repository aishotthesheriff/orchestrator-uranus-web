#Admin & Test Keys
ADMIN_API_KEYS=XXX
TEST_API_KEY=XXX

#Database Configuration
# For local development (outside Docker), use localhost:
DATABASE_URL=mysql://uranus:password@localhost:3306/uranus_dungeon
# For Docker Compose, use the service name:
# DATABASE_URL=mysql://uranus:password@mariadb:3306/uranus_dungeon
# The integration tests use their own database (the name must end in _test):
DATABASE_URL_TEST=mysql://uranus:password@localhost:3306/uranus_dungeon_test
# Most connections the app opens (default 20). Keep it below the host's per-user connection cap.
# DB_POOL_MAX=20

# Session / JWT Configuration
SESSION_SECRET=XXX
# Optional: override JWT signing secret (defaults to SESSION_SECRET)
# JWT_SECRET=XXX

# OpenAI API Configuration
OPENAI_API_KEY=XXX
AI_INTEGRATIONS_OPENAI_API_KEY=XXX
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Hugging Face (for image models)
HF_TOKEN=XXX

# Application Configuration
NODE_ENV=development
PORT=5001

# Security Configuration
ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=false
CSRF_ENABLED=false

CONSOLE_LLM_LOG=true

# LangSmith tracing and evals (optional; off unless LANGSMITH_TRACING=true and a key is set)
# When on, prompts, narration, player-typed actions and interview answers are sent to LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quest-to-uranus
# Only needed outside the US region, e.g. https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=
# Send run structure, timings and metadata but no prompt/response text
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true
# Fraction of traces to keep (0-1). Unset keeps all.
# LANGSMITH_TRACING_SAMPLING_RATE=1

# Image Cache Configuration
# Set to 'false' to disable similarity-based image caching (only exact hash matches will be used)
IMAGE_SIMILARITY_CACHE_ENABLED=true
